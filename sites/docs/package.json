{
	"name": "docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"author": {
		"name": "George Daskalakis",
		"email": "george.dask97@gmail.com",
		"url": "https://github.com/geodask"
	},
	"license": "MIT",
	"scripts": {
		"gen:themes": "node scripts/generate-themes.mjs && prettier --config ../../.prettierrc --log-level warn --write src/lib/themes-data.ts",
		"dev": "npm run gen:themes && vite dev",
		"build": "npm run gen:themes && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run gen:themes && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --config ../../.prettierrc --write .",
		"lint": "prettier --config ../../.prettierrc --check . && eslint .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:coverage": "vitest run",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.70.0",
		"@resvg/resvg-js": "2.6.2",
		"@shikijs/twoslash": "4.6.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"mermaid": "^12.3.0",
		"mode-watcher": "^1.1.0",
		"satori": "0.63.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-docsmith": "workspace:*",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.4",
		"twoslash-svelte": "0.3.9",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
