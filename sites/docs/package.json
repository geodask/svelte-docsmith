{
	"name": "docs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"author": {
		"name": "George Daskalakis",
		"email": "george.dask97@gmail.com",
		"url": "https://github.com/geodask"
	},
	"license": "MIT",
	"scripts": {
		"gen:themes": "node scripts/generate-themes.mjs && prettier --config ../../.prettierrc --log-level warn --write src/lib/themes-data.ts",
		"dev": "npm run gen:themes && vite dev",
		"build": "npm run gen:themes && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run gen:themes && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --config ../../.prettierrc --write .",
		"lint": "prettier --config ../../.prettierrc --check . && eslint .",
		"test": "echo 'No tests configured for docs site'",
		"test:unit": "echo 'No unit tests configured for docs site'",
		"test:coverage": "echo 'No test coverage configured for docs site'",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.70.0",
		"@shikijs/twoslash": "4.6.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"mermaid": "^12.3.0",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-docsmith": "workspace:*",
		"tailwindcss": "^4.3.4",
		"twoslash-svelte": "0.3.9",
		"typescript": "^6.0.3",
		"vite": "^8.3.6"
	}
}
