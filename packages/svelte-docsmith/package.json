{
	"name": "svelte-docsmith",
	"version": "0.16.0",
	"description": "A framework for building beautiful documentation sites with Svelte.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --config ../../.prettierrc --write .",
		"lint": "prettier --config ../../.prettierrc --check . && eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:unit": "vitest run",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"author": {
		"name": "George Daskalakis",
		"email": "george.dask97@gmail.com",
		"url": "https://github.com/geodask"
	},
	"main": "dist/index.js",
	"bin": {
		"svelte-docsmith": "./bin/svelte-docsmith.mjs"
	},
	"files": [
		"dist",
		"bin",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/_fixtures/**"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./preprocess": {
			"types": "./dist/buildtime/preprocess.d.ts",
			"default": "./dist/buildtime/preprocess.js"
		},
		"./vite": {
			"types": "./dist/buildtime/vite/index.d.ts",
			"default": "./dist/buildtime/vite/index.js"
		},
		"./content": {
			"types": "./dist/fallbacks/content.d.ts",
			"default": "./dist/fallbacks/content.js"
		},
		"./search": {
			"types": "./dist/fallbacks/search.d.ts",
			"default": "./dist/fallbacks/search.js"
		},
		"./llms": {
			"types": "./dist/fallbacks/llms.d.ts",
			"default": "./dist/fallbacks/llms.js"
		},
		"./changelog": {
			"types": "./dist/fallbacks/changelog.d.ts",
			"default": "./dist/fallbacks/changelog.js"
		},
		"./mermaid": {
			"types": "./dist/components/docs/mermaid.svelte.d.ts",
			"svelte": "./dist/components/docs/mermaid.svelte",
			"default": "./dist/components/docs/mermaid.svelte"
		},
		"./client": {
			"types": "./dist/client.d.ts"
		},
		"./theme.css": "./dist/theme.css",
		"./themes/*.css": "./dist/themes/*.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/geodask/svelte-docsmith.git"
	},
	"license": "MIT",
	"peerDependencies": {
		"@sveltejs/kit": "^2.16.0 || ^3.0.0",
		"mermaid": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"svelte": "^5.0.0",
		"svelte2tsx": "^0.7.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"peerDependenciesMeta": {
		"mermaid": {
			"optional": true
		},
		"svelte2tsx": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@shikijs/twoslash": "4.6.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "5.1.0",
		"jsdom": "^31.0.0",
		"mermaid": "^12.3.0",
		"publint": "^0.3.25",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte2tsx": "^0.7.63",
		"tailwindcss": "^4.3.4",
		"twoslash-svelte": "0.3.9",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@hbsnow/rehype-sectionize": "^1.0.7",
		"@lucide/svelte": "^1.70.0",
		"@shikijs/transformers": "^4.6.0",
		"@tailwindcss/typography": "^0.5.20",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"esm-env": "^1.2.2",
		"flexsearch": "^0.8.212",
		"github-slugger": "^2.0.0",
		"js-yaml": "^5.5.0",
		"marked": "^18.1.3",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tw-animate-css": "^1.4.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte5",
		"docs",
		"documentation",
		"documentation-generator",
		"docs-site",
		"markdown",
		"mdsvex",
		"shiki",
		"ui",
		"components"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
