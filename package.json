{
	"name": "@svelte-docsmith/monorepo",
	"version": "1.0.0",
	"description": "Monorepo for svelte-docsmith",
	"main": "index.js",
	"private": true,
	"scripts": {
		"ci:version": "node scripts/sync-template-pin.mjs pre && changeset version && node scripts/sync-template-pin.mjs post",
		"ci:publish": "turbo run build --filter=svelte-docsmith && changeset publish",
		"build": "turbo run build",
		"test": "turbo run test",
		"test:unit": "turbo run test:unit",
		"test:coverage": "turbo run test:coverage",
		"typecheck": "turbo run typecheck",
		"check": "turbo run check",
		"check:watch": "turbo run check:watch",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"dev": "turbo run dev",
		"preview": "turbo run preview"
	},
	"keywords": [],
	"author": {
		"name": "George Daskalakis",
		"email": "george.dask97@gmail.com",
		"url": "https://github.com/geodask"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/geodask/svelte-docsmith.git",
		"directory": "packages/svelte-docsmith"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.6.4",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@shikijs/twoslash": "3.23.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"turbo": "^2.11.10",
		"twoslash-svelte": "0.3.9",
		"typescript-eslint": "^8.72.1"
	}
}
